# ============================================================
# TP Integrador BDIA - Sistema de recomendacion de contenidos
#
# Todos los puertos se publican solo en 127.0.0.1.
# Copiar este archivo a .env antes de levantar el entorno.
# ============================================================

# PostgreSQL operacional + vectorial (pgvector)
POSTGRES_DB=bdia_nexomedia
POSTGRES_USER=bdia_user
POSTGRES_PASSWORD=bdia_postgres_local_pass
POSTGRES_PORT=5440

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@bdia.com
PGADMIN_DEFAULT_PASSWORD=bdia_pgadmin_local_pass
PGADMIN_PORT=8090

# MongoDB (clickstream y contenido no estructurado)
MONGO_INITDB_ROOT_USERNAME=bdia_admin
MONGO_INITDB_ROOT_PASSWORD=bdia_mongo_local_pass
MONGO_DATABASE=bdia_nexomedia
MONGO_PORT=27020

# Usuario de ingesta con permiso de INSERT unicamente
MONGO_INGESTA_USER=bdia_mongo_ingesta
MONGO_INGESTA_PASSWORD=ingesta_local

# Mongo Express (visor)
ME_CONFIG_BASICAUTH_USERNAME=admin
ME_CONFIG_BASICAUTH_PASSWORD=admin_local
MONGO_EXPRESS_PORT=8091

# Redis (capa de serving online)
REDIS_PASSWORD=bdia_redis_local_pass
REDIS_PORT=6390

# Neo4j (grafo de recomendacion)
NEO4J_USER=neo4j
NEO4J_PASSWORD=bdia_neo4j_local_pass
NEO4J_HTTP_PORT=7476
NEO4J_BOLT_PORT=7690

# MinIO (object storage del lakehouse)
MINIO_ROOT_USER=bdia_minio
MINIO_ROOT_PASSWORD=bdia_minio_local_pass
MINIO_API_PORT=9010
MINIO_CONSOLE_PORT=9011

# API de recomendacion (demo)
API_PORT=8020

# Rol restringido con el que se conecta la API.
# NO es superusuario: esta sujeto a Row Level Security.
API_DB_USER=bdia_api
API_DB_PASSWORD=api_local

# Usuarios de minimo privilegio con los que la API consulta cada motor.
# Los crean pasos del pipeline; por eso la API arranca al final, con
# el perfil de Compose "consumo".
MONGO_LECTURA_USER=bdia_mongo_lectura
MONGO_LECTURA_PASSWORD=lectura_local
REDIS_LECTURA_USER=app_lectura
REDIS_LECTURA_PASSWORD=lectura_local
NEO4J_CONSULTA_USER=bdia_grafo_consulta
NEO4J_CONSULTA_PASSWORD=consulta_local

# Usuario de MinIO acotado al bucket lakehouse, con lectura y escritura,
# que usa el transformador DuckDB en lugar de las credenciales root.
MINIO_TRANSFORMADOR_USER=bdia_lake_transformador
MINIO_TRANSFORMADOR_PASSWORD=transformador_local

# Embeddings
# MODO=modelo   -> descarga y usa sentence-transformers
# MODO=simulado -> vectores deterministas por hash, sin descargar nada
MODELO_EMBEDDING=intfloat/multilingual-e5-small
EMBEDDINGS_MODO=modelo

# Generacion de datos sinteticos
SEMILLA=42
ESCALA=media
